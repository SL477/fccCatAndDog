{
    "compilerOptions": {
        "module": "esnext",
        "target": "ES2020",
        "sourceMap": true,
        "outDir": "dist",
        "rootDir": "src",
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        //"watch": true,
        "removeComments": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [],
        "typeRoots": ["./node_modules/@types"]
    },
    "compileOnSave": true,
    "lib": ["ES2015"],
    "include": ["src"],
    "exclude": ["node_modules"]
}